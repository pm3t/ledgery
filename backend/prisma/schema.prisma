model StockReceiptOtherLine {
  id             String            @id @default(uuid())
  receiptOtherId String
  itemId         String
  qty            Decimal           @db.Decimal(19, 4)
  biayaSatuan    Decimal           @db.Decimal(19, 4)
  totalNilai     Decimal           @db.Decimal(19, 4)
  catatan        String?

  receiptOther   StockReceiptOther @relation(fields: [receiptOtherId], references: [id], onDelete: Cascade)
