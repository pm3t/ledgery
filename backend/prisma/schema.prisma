  journal        Journal?                @relation("StockReceiptOtherJournal", fields: [journalId], references: [id], onDelete: SetNull)
  voidJournal    Journal?                @relation("StockReceiptOtherVoidJournal", fields: [voidJournalId], references: [id], onDelete: SetNull)
