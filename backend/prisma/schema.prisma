// Prisma Schema untuk Ledgery — SaaS Akuntansi Multi-Tenant
// PT. Anugerah Bakti Prima

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum untuk Kategori Akun pada Chart of Accounts
enum KategoriAkun {
  ASET
  LIABILITAS
  EKUITAS
  PENDAPATAN
  BEBAN
}

// Enum Tipe Akun Kontrol Subledger
enum ControlAccountType {
  NONE
  AR
  AP
  INVENTORY
}

// Enum untuk Kebijakan Posting Jurnal
enum PostingPolicyMode {
  AUTO_POST
  APPROVAL_MANUAL
}

// Enum Status Langganan Tenant
enum StatusLangganan {
  ACTIVE
  INACTIVE
  TRIAL
}

// Enum Status Billing
enum BillingStatus {
  PAID
  UNPAID
  OVERDUE
}

// Enum Role User
enum UserRole {
  SUPER_ADMIN
  STAF_AKUNTANSI
  ADMIN_TENANT
}

// Model Tenant (Entitas Perusahaan / Pelanggan SaaS)
model Tenant {
  id               String          @id @default(uuid())
  nama_perusahaan  String
  tahun_buku_mulai Int             @default(2026)
  mata_uang        String          @default("IDR")
  status_langganan StatusLangganan @default(ACTIVE)
  billingDueDate   DateTime?
  billingStatus    BillingStatus   @default(UNPAID)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relasi
  chartOfAccounts ChartOfAccount[]
  apiKeys         ApiKey[]
  postingPolicy   PostingPolicySetting?
  journals        Journal[]
  notifications   Notification[]
  taxSetting      TaxSetting?
  taxRecaps       TaxRecap[]
  IntegrationLog  IntegrationLog[]
  users           User[]
  dimensions      Dimension[]
  exchangeRates   ExchangeRate[]
  fiscalYears     FiscalYear[]
  subledgerSetting SubledgerSetting?
  postingSetups    PostingSetup[]
  businessPartners BusinessPartner[]
  documentNumberings DocumentNumbering[]
  salesInvoices      SalesInvoice[]
  creditNotes        CreditNote[]
  customerReceipts   CustomerReceipt[]
}

// Model Chart of Accounts (Daftar Kode Akun)
model ChartOfAccount {
  id               String             @id @default(uuid())
  tenantId         String
  kode_akun        String
  nama_akun        String
  kategori         KategoriAkun
  parentId         String?
  isActive         Boolean            @default(true)
  isControlAccount Boolean            @default(false)
  controlType      ControlAccountType @default(NONE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Relasi Tenant
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relasi Induk - Anak (Self-Relation)
  parent   ChartOfAccount?  @relation("AccountParent", fields: [parentId], references: [id], onDelete: SetNull)
  children ChartOfAccount[] @relation("AccountParent")

  // Relasi Jurnal
  journalEntries JournalEntry[]
  postingSetups  PostingSetup[]
  salesInvoiceLines SalesInvoiceLine[]
  creditNoteLines   CreditNoteLine[]
  customerReceipts  CustomerReceipt[]

  @@unique([tenantId, kode_akun])
}

// Model API Key (Kredensial Integrasi Aplikasi Sumber)
model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  key_hash   String    @unique
  nama_label String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // Relasi Tenant
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Model Pengaturan Kebijakan Posting Jurnal per Tenant
model PostingPolicySetting {
  id        String            @id @default(uuid())
  tenantId  String            @unique
  mode      PostingPolicyMode @default(AUTO_POST)
  updatedBy String?           @default("system")
  updatedAt DateTime          @updatedAt

  // Relasi Tenant
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Enum Status Jurnal
enum JournalStatus {
  POSTED
  PENDING
  APPROVED
  REJECTED
}

// Enum Tipe Entri Jurnal
enum EntryType {
  DEBIT
  KREDIT
}

// Model Header Jurnal
model Journal {
  id                      String        @id @default(uuid())
  tenantId                String
  no_voucher              String
  tanggal                 DateTime
  deskripsi               String
  sumber_aplikasi         String
  status                  JournalStatus
  idempotency_key         String?
  idempotency_payload_hash String?
  sourceDocType           String?
  sourceDocId             String?
  mata_uang               String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relasi
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries      JournalEntry[]
  approvalLogs JournalApprovalLog[]
  salesInvoices        SalesInvoice[]        @relation("InvoiceJournal")
  voidSalesInvoices    SalesInvoice[]        @relation("InvoiceVoidJournal")
  creditNotes          CreditNote[]          @relation("CreditNoteJournal")
  voidCreditNotes      CreditNote[]          @relation("CreditNoteVoidJournal")
  customerReceipts     CustomerReceipt[]     @relation("ReceiptJournal")
  voidCustomerReceipts CustomerReceipt[]     @relation("ReceiptVoidJournal")

  // Constraint
  @@unique([tenantId, no_voucher])
  @@unique([tenantId, idempotency_key])
}

// Model Baris Entri Jurnal (Debit/Kredit)
model JournalEntry {
  id               String    @id @default(uuid())
  journalId        String
  chartOfAccountId String
  tipe             EntryType
  jumlah           Decimal   @db.Decimal(19, 4)
  jumlah_asli      Decimal?  @db.Decimal(19, 4)
  jumlah_konversi  Decimal?  @db.Decimal(19, 4)

  // Relasi
  journal        Journal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  chartOfAccount ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)
  dimensions     JournalEntryDimension[]
}

// Enum Aksi Approval
enum ApprovalAction {
  APPROVED
  REJECTED
}

// Model Riwayat Persetujuan Jurnal
model JournalApprovalLog {
  id          String         @id @default(uuid())
  journalId   String
  action      ApprovalAction
  alasan      String?
  actorUserId String
  createdAt   DateTime       @default(now())

  // Relasi
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
}

// Model Notifikasi (In-App)
model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  judul     String
  pesan     String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relasi
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Enum untuk Jenis Pajak
enum JenisPajak {
  PPN
  PPH21
}

// Model Pengaturan Pajak per Tenant
model TaxSetting {
  id             String  @id @default(uuid())
  tenantId       String  @unique
  tarif_ppn      Float   @default(11.0)
  npwp           String?
  aktifkan_pph21 Boolean @default(false)

  // Relasi
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Model Rekapitulasi Pajak
model TaxRecap {
  id                    String     @id @default(uuid())
  tenantId              String
  jenis_pajak           JenisPajak
  periode               String // Format "YYYY-MM"
  total_dasar_pengenaan Float
  total_pajak           Float
  createdAt             DateTime   @default(now())

  // Relasi
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Model Audit Log untuk akses Super Admin ke data spesifik Tenant
model AuditLog {
  id             String   @id @default(uuid())
  actorRole      String // misal: "SUPER_ADMIN"
  action         String // misal: "VIEW_TENANT_JOURNALS"
  targetTenantId String
  deskripsi      String
  createdAt      DateTime @default(now())
}

// Model Log Integrasi API
model IntegrationLog {
  id              String   @id @default(uuid())
  tenantId        String
  apiKeyId        String? // Null jika gagal autentikasi
  endpoint        String
  versi_api       String
  statusCode      Int
  payload_ringkas String   @db.Text
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Model User untuk autentikasi dan manajemen hak akses
model User {
  id             String    @id @default(uuid())
  tenantId       String? // Null untuk SUPER_ADMIN (tidak terikat tenant)
  nama           String
  email          String    @unique
  password_hash  String
  role           UserRole
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relasi (SUPER_ADMIN tidak punya tenant)
  tenant                Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  passwordResetTokens   PasswordResetToken[]
}

// Model Token Reset Password (dikirim via email)
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Model Dimension (Kategori Dimensi, misal: Project, Cost Center)
model Dimension {
  id             String           @id @default(uuid())
  tenantId       String
  nama_dimension String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())

  // Relasi
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values         DimensionValue[]

  @@unique([tenantId, nama_dimension])
}

// Model DimensionValue (Nilai dari Dimensi, misal: PRJ001)
model DimensionValue {
  id          String    @id @default(uuid())
  dimensionId String
  kode        String
  nama        String
  isActive    Boolean   @default(true)

  // Relasi
  dimension      Dimension               @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  journalEntries JournalEntryDimension[]

  @@unique([dimensionId, kode])
}

// Model Pivot JournalEntry dengan DimensionValue
model JournalEntryDimension {
  id               String         @id @default(uuid())
  journalEntryId   String
  dimensionId      String
  dimensionValueId String

  // Relasi
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  dimensionValue DimensionValue @relation(fields: [dimensionValueId], references: [id], onDelete: Restrict)
}

// Model Currency (Mata Uang)
model Currency {
  id        String   @id @default(uuid())
  kode_iso  String   @unique
  nama      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relasi
  exchangeRates ExchangeRate[]
}

// Model ExchangeRate (Kurs Harian per Tenant)
model ExchangeRate {
  id         String   @id @default(uuid())
  tenantId   String
  currencyId String
  tanggal    DateTime
  kurs       Float
  createdBy  String?
  createdAt  DateTime @default(now())

  // Relasi
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, currencyId, tanggal])
}

// Enum Status Periode Akuntansi
enum PeriodStatus {
  OPEN
  CLOSED
}

// Model Tahun Buku
model FiscalYear {
  id                String             @id @default(uuid())
  tenantId          String
  nama_tahun_buku   String
  tanggal_mulai     DateTime
  tanggal_selesai   DateTime
  createdAt         DateTime           @default(now())

  // Relasi
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountingPeriods AccountingPeriod[]
}

// Model Periode Akuntansi
model AccountingPeriod {
  id              String       @id @default(uuid())
  fiscalYearId    String
  nomor_periode   Int
  tanggal_mulai   DateTime
  tanggal_selesai DateTime
  status          PeriodStatus @default(OPEN)
  closedAt        DateTime?
  closedBy        String?
  reopenedAt      DateTime?
  reopenedBy      String?

  // Relasi
  fiscalYear      FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  @@unique([fiscalYearId, nomor_periode])
}

// ==========================================
// MODUL SUBLEDGER FONDASI (AR, AP, INVENTORY)
// ==========================================

enum InventoryValuationMethod {
  MOVING_AVERAGE
  FIFO
}

enum CreditLimitMode {
  WARN
  BLOCK
}

enum PostingSetupKey {
  AR_CONTROL
  SALES_REVENUE
  SALES_DISCOUNT
  PPN_KELUARAN
  AP_CONTROL
  PURCHASE_EXPENSE
  PURCHASE_DISCOUNT
  PPN_MASUKAN
  INVENTORY
  COGS
  INVENTORY_ADJUSTMENT
  GR_IR_CLEARING
  PURCHASE_PRICE_VARIANCE
  FX_GAIN_LOSS
  CASH_DEFAULT
}

model SubledgerSetting {
  id                       String                   @id @default(uuid())
  tenantId                 String                   @unique
  arEnabled                Boolean                  @default(false)
  apEnabled                Boolean                  @default(false)
  inventoryEnabled         Boolean                  @default(false)
  orderManagementEnabled   Boolean                  @default(false)
  defaultValuationMethod   InventoryValuationMethod @default(MOVING_AVERAGE)
  overDeliveryTolerancePct Float                    @default(0)
  allowNegativeStock       Boolean                  @default(false)
  creditLimitMode          CreditLimitMode          @default(WARN)
  agingBuckets             Json                     @default("[30, 60, 90]")
  blockPeriodCloseOnRecon  Boolean                  @default(false)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PostingSetup {
  id        String          @id @default(uuid())
  tenantId  String
  key       PostingSetupKey
  accountId String
  groupCode String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, key])
}

model BusinessPartner {
  id                 String   @id @default(uuid())
  tenantId           String
  kode               String
  nama               String
  npwp               String?
  alamat             String?
  kontak             String?
  termPembayaranHari Int      @default(30)
  creditLimit        Decimal? @db.Decimal(19, 4)
  mata_uang          String
  isCustomer         Boolean  @default(false)
  isVendor           Boolean  @default(false)
  groupCode          String?
  externalRef        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoices    SalesInvoice[]
  creditNotes      CreditNote[]
  customerReceipts CustomerReceipt[]

  @@unique([tenantId, kode])
  @@unique([tenantId, externalRef])
  @@index([tenantId, isCustomer])
  @@index([tenantId, isVendor])
}

model DocumentNumbering {
  id            String   @id @default(uuid())
  tenantId      String
  docType       String
  prefix        String
  formatPattern String   @default("{PREFIX}-{YYYY}-{SEQ:5}")
  lastSeq       Int      @default(0)
  year          Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, docType, year])
}

// ==========================================
// MODUL 13: SUB LEDGER ACCOUNTS RECEIVABLE (AR)
// ==========================================

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  PARTIAL
  PAID
  VOID
}

enum CreditNoteStatus {
  DRAFT
  POSTED
  VOID
}

enum CustomerReceiptStatus {
  DRAFT
  POSTED
  VOID
}

enum SourceLineType {
  SO_LINE
  DO_LINE
}

model SalesInvoice {
  id                     String             @id @default(uuid())
  tenantId               String
  noDokumen              String
  tanggal                DateTime
  jatuhTempo             DateTime
  partnerId              String
  mata_uang              String
  kurs                   Decimal            @default(1.0) @db.Decimal(19, 6)
  status                 SalesInvoiceStatus @default(DRAFT)
  subtotal               Decimal            @default(0) @db.Decimal(19, 4)
  totalDiskon            Decimal            @default(0) @db.Decimal(19, 4)
  totalPpn               Decimal            @default(0) @db.Decimal(19, 4)
  total                  Decimal            @default(0) @db.Decimal(19, 4)
  totalDialokasikan      Decimal            @default(0) @db.Decimal(19, 4)
  saldo                  Decimal            @default(0) @db.Decimal(19, 4)
  subtotalFungsional     Decimal            @default(0) @db.Decimal(19, 4)
  totalDiskonFungsional  Decimal            @default(0) @db.Decimal(19, 4)
  totalPpnFungsional     Decimal            @default(0) @db.Decimal(19, 4)
  totalFungsional        Decimal            @default(0) @db.Decimal(19, 4)
  saldoFungsional        Decimal            @default(0) @db.Decimal(19, 4)
  journalId              String?
  voidJournalId          String?
  externalRef            String?
  sumberAplikasi         String             @default("MANUAL")
  idempotencyKey         String?
  catatan                String?
  createdBy              String?
  postedAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner     BusinessPartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  journal     Journal?            @relation("InvoiceJournal", fields: [journalId], references: [id], onDelete: SetNull)
  voidJournal Journal?            @relation("InvoiceVoidJournal", fields: [voidJournalId], references: [id], onDelete: SetNull)
  lines       SalesInvoiceLine[]
  allocations ReceiptAllocation[]
  creditNotes CreditNote[]

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, partnerId, status])
  @@index([tenantId, tanggal])
}

model SalesInvoiceLine {
  id               String          @id @default(uuid())
  invoiceId        String
  itemId           String?
  itemType         String?         @default("SERVICE") // "STOCK" | "SERVICE"
  deskripsi        String
  qty              Decimal         @default(1) @db.Decimal(19, 4)
  hargaSatuan      Decimal         @default(0) @db.Decimal(19, 4)
  diskon           Decimal         @default(0) @db.Decimal(19, 4)
  ppnRate          Decimal         @default(0) @db.Decimal(19, 4)
  jumlah           Decimal         @default(0) @db.Decimal(19, 4)
  akunPendapatanId String?
  dimensions       Json?
  sourceLineType   SourceLineType?
  sourceLineId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invoice        SalesInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  akunPendapatan ChartOfAccount? @relation(fields: [akunPendapatanId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model CreditNote {
  id                     String             @id @default(uuid())
  tenantId               String
  noDokumen              String
  tanggal                DateTime
  partnerId              String
  invoiceId              String?
  returnStock            Boolean            @default(false)
  mata_uang              String
  kurs                   Decimal            @default(1.0) @db.Decimal(19, 6)
  status                 CreditNoteStatus   @default(DRAFT)
  subtotal               Decimal            @default(0) @db.Decimal(19, 4)
  totalDiskon            Decimal            @default(0) @db.Decimal(19, 4)
  totalPpn               Decimal            @default(0) @db.Decimal(19, 4)
  total                  Decimal            @default(0) @db.Decimal(19, 4)
  totalDialokasikan      Decimal            @default(0) @db.Decimal(19, 4)
  saldo                  Decimal            @default(0) @db.Decimal(19, 4)
  subtotalFungsional     Decimal            @default(0) @db.Decimal(19, 4)
  totalDiskonFungsional  Decimal            @default(0) @db.Decimal(19, 4)
  totalPpnFungsional     Decimal            @default(0) @db.Decimal(19, 4)
  totalFungsional        Decimal            @default(0) @db.Decimal(19, 4)
  saldoFungsional        Decimal            @default(0) @db.Decimal(19, 4)
  journalId              String?
  voidJournalId          String?
  externalRef            String?
  sumberAplikasi         String             @default("MANUAL")
  idempotencyKey         String?
  catatan                String?
  createdBy              String?
  postedAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner     BusinessPartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  invoice     SalesInvoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  journal     Journal?            @relation("CreditNoteJournal", fields: [journalId], references: [id], onDelete: SetNull)
  voidJournal Journal?            @relation("CreditNoteVoidJournal", fields: [voidJournalId], references: [id], onDelete: SetNull)
  lines       CreditNoteLine[]
  allocations ReceiptAllocation[]

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, partnerId, status])
}

model CreditNoteLine {
  id               String          @id @default(uuid())
  creditNoteId     String
  itemId           String?
  itemType         String?         @default("SERVICE")
  deskripsi        String
  qty              Decimal         @default(1) @db.Decimal(19, 4)
  hargaSatuan      Decimal         @default(0) @db.Decimal(19, 4)
  diskon           Decimal         @default(0) @db.Decimal(19, 4)
  ppnRate          Decimal         @default(0) @db.Decimal(19, 4)
  jumlah           Decimal         @default(0) @db.Decimal(19, 4)
  akunPendapatanId String?
  dimensions       Json?
  sourceLineType   SourceLineType?
  sourceLineId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  creditNote     CreditNote      @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  akunPendapatan ChartOfAccount? @relation(fields: [akunPendapatanId], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
}

model CustomerReceipt {
  id                String                @id @default(uuid())
  tenantId          String
  noDokumen         String
  tanggal           DateTime
  partnerId         String
  akunKasBankId     String
  jumlah            Decimal               @db.Decimal(19, 4)
  jumlahFungsional  Decimal               @default(0) @db.Decimal(19, 4)
  mata_uang         String
  kurs              Decimal               @default(1.0) @db.Decimal(19, 6)
  status            CustomerReceiptStatus @default(DRAFT)
  totalDialokasikan Decimal               @default(0) @db.Decimal(19, 4)
  belumDialokasikan Decimal               @default(0) @db.Decimal(19, 4)
  journalId         String?
  voidJournalId     String?
  externalRef       String?
  sumberAplikasi    String                @default("MANUAL")
  idempotencyKey    String?
  catatan           String?
  createdBy         String?
  postedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner     BusinessPartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  akunKasBank ChartOfAccount      @relation(fields: [akunKasBankId], references: [id], onDelete: Restrict)
  journal     Journal?            @relation("ReceiptJournal", fields: [journalId], references: [id], onDelete: SetNull)
  voidJournal Journal?            @relation("ReceiptVoidJournal", fields: [voidJournalId], references: [id], onDelete: SetNull)
  allocations ReceiptAllocation[]

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, partnerId, status])
}

model ReceiptAllocation {
  id             String          @id @default(uuid())
  receiptId      String
  invoiceId      String?
  creditNoteId   String?
  jumlahAlokasi  Decimal         @db.Decimal(19, 4)
  kursAlokasi    Decimal         @default(1.0) @db.Decimal(19, 6)
  selisihKurs    Decimal         @default(0) @db.Decimal(19, 4)
  tanggalAlokasi DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  receipt    CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoice    SalesInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  creditNote CreditNote?     @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([invoiceId])
  @@index([creditNoteId])
}



