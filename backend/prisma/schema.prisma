// ==========================================
// MODUL 19: SUB LEDGER KAS & BANK (V4)
// ==========================================

enum CashBankAccountType {
  KAS_TUNAI
  KAS_KECIL
  BANK
  DOMPET_DIGITAL
}

enum CashBankEntryDirection {
  MASUK
  KELUAR
}

enum CashBankSourceType {
  CASH_RECEIPT
  CASH_DISBURSEMENT
  CASH_TRANSFER
  PETTY_REPLENISH
  PETTY_VOUCHER
  CUSTOMER_RECEIPT
  VENDOR_PAYMENT
  JOURNAL_CAPTURE
  OPENING
  OTHER
}

enum CashDocStatus {
  DRAFT
  POSTED
  VOID
}

enum CashTransferVariant {
  TRANSFER
  PENGISIAN_KAS_KECIL
}

model CashBankAccount {
  id               String               @id @default(uuid())
  tenantId         String
  kode             String
  nama             String
  jenis            CashBankAccountType
  chartOfAccountId String
  mata_uang        String
  namaBank         String?
  noRekening       String?
  namaPemilik      String?
  plafonKasKecil   Decimal?             @db.Decimal(19, 4)
  externalRef      String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccount       @relation(fields: [chartOfAccountId], references: [id])
  entries          CashBankEntry[]
  receipts         CashReceipt[]
  disbursements    CashDisbursement[]
  transfersFrom    CashTransfer[]       @relation("TransferDari")
  transfersTo      CashTransfer[]       @relation("TransferKe")
  customerReceipts CustomerReceipt[]
  vendorPayments   VendorPayment[]
  statementImports BankStatementImport[]
  statementLines   BankStatementLine[]
  bankReconciliations BankReconciliation[]
  importTemplates  BankImportTemplate[]
  assetDisposals   AssetDisposal[]

  @@unique([tenantId, kode])
  @@unique([tenantId, chartOfAccountId])
  @@index([tenantId, isActive])
}

model CashBankEntry {
  id                 String                 @id @default(uuid())
  tenantId           String
  cashBankAccountId  String
  tanggal            DateTime
  arah               CashBankEntryDirection
  jumlah             Decimal                @db.Decimal(19, 4)
  jumlahFungsional   Decimal                @db.Decimal(19, 4)
  journalEntryId     String?                @unique
  journalId          String?
  sourceType         CashBankSourceType
  sourceDocId        String?
  keterangan         String
  reconciliationId   String?
  clearedAt          DateTime?
  createdAt          DateTime               @default(now())

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashBankAccount    CashBankAccount        @relation(fields: [cashBankAccountId], references: [id], onDelete: Cascade)
  journalEntry       JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  journal            Journal?               @relation(fields: [journalId], references: [id], onDelete: SetNull)
  reconciliation     BankReconciliation?    @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  matches            BankMatch[]

  @@index([tenantId, cashBankAccountId, tanggal])
  @@index([tenantId, sourceType])
}

model CashReceipt {
  id                String             @id @default(uuid())
  tenantId          String
  noDokumen         String
  tanggal           DateTime
  cashBankAccountId String
  mata_uang         String
  kurs              Decimal            @default(1.0) @db.Decimal(19, 6)
  status            CashDocStatus      @default(DRAFT)
  total             Decimal            @db.Decimal(19, 4)
  journalId         String?
  externalRef       String?
  idempotencyKey    String?
  catatan           String?
  createdBy         String?
  postedAt          DateTime?
  docVariant        String             @default("STANDARD")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashBankAccount   CashBankAccount    @relation(fields: [cashBankAccountId], references: [id])
  journal           Journal?           @relation("CashReceiptJournal", fields: [journalId], references: [id], onDelete: SetNull)
  lines             CashReceiptLine[]

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, tanggal])
}

model CashReceiptLine {
  id          String         @id @default(uuid())
  headerId    String
  akunLawanId String
  deskripsi   String
  jumlah      Decimal        @db.Decimal(19, 4)
  dimensions  Json?
  createdAt   DateTime       @default(now())

  header      CashReceipt    @relation(fields: [headerId], references: [id], onDelete: Cascade)
  akunLawan   ChartOfAccount @relation(fields: [akunLawanId], references: [id])

  @@index([headerId])
}

model CashDisbursement {
  id                String                 @id @default(uuid())
  tenantId          String
  noDokumen         String
  tanggal           DateTime
  cashBankAccountId String
  mata_uang         String
  kurs              Decimal                @default(1.0) @db.Decimal(19, 6)
  status            CashDocStatus          @default(DRAFT)
  total             Decimal                @db.Decimal(19, 4)
  journalId         String?
  externalRef       String?
  idempotencyKey    String?
  catatan           String?
  createdBy         String?
  postedAt          DateTime?
  docVariant        String                 @default("STANDARD")
  replenishmentId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashBankAccount   CashBankAccount        @relation(fields: [cashBankAccountId], references: [id])
  journal           Journal?               @relation("CashDisbursementJournal", fields: [journalId], references: [id], onDelete: SetNull)
  lines             CashDisbursementLine[]

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, tanggal])
  @@index([tenantId, replenishmentId])
}

model CashDisbursementLine {
  id                String           @id @default(uuid())
  headerId          String
  akunLawanId       String?
  deskripsi         String
  jumlah            Decimal          @db.Decimal(19, 4)
  dimensions        Json?
  lineType          String?          @default("BIAYA") // "BIAYA" | "ASET"
  assetCategoryId   String?
  kapitalisasiKeCip Boolean          @default(false)
  assetId           String?
  createdAt         DateTime         @default(now())

  header            CashDisbursement @relation(fields: [headerId], references: [id], onDelete: Cascade)
  akunLawan         ChartOfAccount?  @relation(fields: [akunLawanId], references: [id])

  @@index([headerId])
}

model CashTransfer {
  id             String              @id @default(uuid())
  tenantId       String
  noDokumen      String
  tanggal        DateTime
  dariAccountId  String
  keAccountId    String
  jumlahKeluar   Decimal             @db.Decimal(19, 4)
  jumlahMasuk    Decimal             @db.Decimal(19, 4)
  kurs           Decimal             @default(1.0) @db.Decimal(19, 6)
  biayaTransfer  Decimal?            @db.Decimal(19, 4)
  akunBiayaId    String?
  variant        CashTransferVariant @default(TRANSFER)
  status         CashDocStatus       @default(DRAFT)
  journalId      String?
  externalRef    String?
  idempotencyKey String?
  catatan        String?
  createdBy      String?
  postedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dariAccount    CashBankAccount     @relation("TransferDari", fields: [dariAccountId], references: [id])
  keAccount      CashBankAccount     @relation("TransferKe", fields: [keAccountId], references: [id])
  akunBiaya      ChartOfAccount?     @relation(fields: [akunBiayaId], references: [id])
  journal        Journal?            @relation("CashTransferJournal", fields: [journalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, tanggal])
}

// =========================================================================
// MODUL 20: REKONSILIASI BANK (BANK RECONCILIATION)
// =========================================================================

enum BankMatchStatus {
  UNMATCHED
  MATCHED
  ADJUSTED
  IGNORED
}

enum BankReconStatus {
  DRAFT
  SELESAI
  DIBUKA_KEMBALI
}

enum BankImportNominalMode {
  DEBIT_KREDIT_TERPISAH
  SATU_KOLOM_BERTANDA
}

model BankStatementImport {
  id                 String              @id @default(uuid())
  tenantId           String
  cashBankAccountId  String
  namaFile           String
  periodeAwal        DateTime
  periodeAkhir       DateTime
  saldoAwal          Decimal             @db.Decimal(19, 4)
  saldoAkhir         Decimal             @db.Decimal(19, 4)
  importedBy         String
  importedAt         DateTime            @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashBankAccount    CashBankAccount     @relation(fields: [cashBankAccountId], references: [id], onDelete: Cascade)
  lines              BankStatementLine[]

  @@index([tenantId, cashBankAccountId, importedAt])
}

model BankStatementLine {
  id                String            @id @default(uuid())
  importId          String
  tenantId          String
  cashBankAccountId String
  tanggal           DateTime
  keterangan        String
  referensi         String?
  debit             Decimal           @default(0) @db.Decimal(19, 4)
  kredit            Decimal           @default(0) @db.Decimal(19, 4)
  saldo             Decimal?          @db.Decimal(19, 4)
  dedupeHash        String
  matchStatus       BankMatchStatus   @default(UNMATCHED)
  ignoreReason      String?
  externalRef       String?
  createdAt         DateTime          @default(now())

  import            BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashBankAccount   CashBankAccount     @relation(fields: [cashBankAccountId], references: [id], onDelete: Cascade)
  matches           BankMatch[]

  @@unique([cashBankAccountId, dedupeHash])
  @@index([tenantId, cashBankAccountId, tanggal])
  @@index([tenantId, matchStatus])
}

model BankReconciliation {
  id                 String           @id @default(uuid())
  tenantId           String
  cashBankAccountId  String
  tanggalAkhir       DateTime
  saldoRekeningKoran Decimal          @db.Decimal(19, 4)
  saldoBuku          Decimal          @db.Decimal(19, 4)
  selisih            Decimal          @db.Decimal(19, 4)
  status             BankReconStatus  @default(DRAFT)
  completedBy        String?
  completedAt        DateTime?
  reopenedBy         String?
  reopenedAt         DateTime?
  reopenReason       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashBankAccount    CashBankAccount  @relation(fields: [cashBankAccountId], references: [id], onDelete: Cascade)
  matches            BankMatch[]
  entries            CashBankEntry[]

  @@index([tenantId, cashBankAccountId, tanggalAkhir])
}

model BankMatch {
  id                String             @id @default(uuid())
  reconciliationId  String?
  statementLineId   String
  cashBankEntryId   String
  jumlahAlokasi     Decimal            @db.Decimal(19, 4)
  createdAt         DateTime           @default(now())

  reconciliation    BankReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  statementLine     BankStatementLine  @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  cashBankEntry     CashBankEntry      @relation(fields: [cashBankEntryId], references: [id], onDelete: Cascade)

  @@index([statementLineId])
  @@index([cashBankEntryId])
  @@index([reconciliationId])
}

model BankImportTemplate {
  id                String                @id @default(uuid())
  tenantId          String
  cashBankAccountId String
  pemetaanKolom     Json
  formatTanggal     String
  pemisahDesimal    String                @default(",")
  pemisahRibuan     String                @default(".")
  modeNominal       BankImportNominalMode @default(DEBIT_KREDIT_TERPISAH)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashBankAccount   CashBankAccount       @relation(fields: [cashBankAccountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cashBankAccountId])
}

// =========================================================================
// MODUL 21: SUB LEDGER ASET TETAP (FIXED ASSET FOUNDATION & CIP)
// =========================================================================

enum FiscalGroupType {
  BUKAN_BANGUNAN
  BANGUNAN
}

enum AssetCategoryType {
  BERWUJUD
  TAK_BERWUJUD
}

enum DepreciationMethod {
  GARIS_LURUS
  SALDO_MENURUN
}

enum FiscalStartRule {
  BULAN_PEROLEHAN
  BULAN_PRODUKSI_KOMERSIAL
}

enum FixedAssetStatus {
  DRAFT
  CIP
  AKTIF
  DISUSUTKAN_PENUH
  DIJUAL
  DIHAPUSKAN
}

enum AssetEventType {
  PEROLEHAN
  KAPITALISASI
  PENAMBAHAN_NILAI
  PENYUSUTAN
  PERUBAHAN_ESTIMASI
  MUTASI
  PENURUNAN_NILAI
  PELEPASAN
  PENGHAPUSAN
  VOID
}

enum AssetLabelStatus {
  BELUM_DILABEL
  TERCETAK
  TERPASANG
  RUSAK_HILANG
}

enum AssetCapitalizationStatus {
  DRAFT
  POSTED
  VOID
}

// Kelompok Penyusutan Fiskal (PMK 72/2023)
// Nilai ini dapat diedit oleh Tenant / Super Admin, bukan konstanta mati
model FiscalDepreciationGroup {
  id                String            @id @default(uuid())
  tenantId          String
  kode              String
  nama              String
  jenis             FiscalGroupType
  masaManfaatBulan  Int
  tarifGarisLurus   Decimal           @db.Decimal(5, 2) // % per tahun (mis. 25.00)
  tarifSaldoMenurun Decimal?          @db.Decimal(5, 2) // % per tahun (mis. 50.00), null untuk bangunan
  isSeed            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories        AssetCategory[]
  fixedAssets       FixedAsset[]

  @@unique([tenantId, kode])
  @@index([tenantId])
}

// Master Kategori Aset Tetap
model AssetCategory {
  id                            String             @id @default(uuid())
  tenantId                      String
  kode                          String
  nama                          String
  jenis                         AssetCategoryType  @default(BERWUJUD)
  dapatDisusutkan               Boolean            @default(true)
  metodeKomersial               DepreciationMethod @default(GARIS_LURUS)
  faktorSaldoMenurun            Float              @default(2.0)
  umurManfaatBulan              Int                @default(48)
  nilaiResiduPersen             Float?             @default(0)
  nilaiResiduNominal            Decimal?           @db.Decimal(19, 4)
  fiscalGroupId                 String?
  metodeFiskal                  DepreciationMethod @default(GARIS_LURUS)
  aturanMulaiFiskal             FiscalStartRule    @default(BULAN_PEROLEHAN)
  akunAsetId                    String
  akunAkumulasiId               String
  akunBebanId                   String
  akunCipId                     String
  akunLabaRugiPelepasanId       String
  akunRugiPenurunanNilaiId      String
  akunAkumulasiPenurunanNilaiId String?
  akunRugiPenghapusanId         String
  isActive                      Boolean            @default(true)
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  tenant                        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalGroup                   FiscalDepreciationGroup? @relation(fields: [fiscalGroupId], references: [id], onDelete: SetNull)
  akunAset                      ChartOfAccount     @relation("CatAkunAset", fields: [akunAsetId], references: [id])
  akunAkumulasi                 ChartOfAccount     @relation("CatAkunAkumulasi", fields: [akunAkumulasiId], references: [id])
  akunBeban                     ChartOfAccount     @relation("CatAkunBeban", fields: [akunBebanId], references: [id])
  akunCip                       ChartOfAccount     @relation("CatAkunCip", fields: [akunCipId], references: [id])
  akunLabaRugiPelepasan         ChartOfAccount     @relation("CatAkunLabaRugiPelepasan", fields: [akunLabaRugiPelepasanId], references: [id])
  akunRugiPenurunanNilai        ChartOfAccount     @relation("CatAkunRugiPenurunanNilai", fields: [akunRugiPenurunanNilaiId], references: [id])
  akunAkumulasiPenurunanNilai   ChartOfAccount?    @relation("CatAkunAkumulasiPenurunanNilai", fields: [akunAkumulasiPenurunanNilaiId], references: [id])
  akunRugiPenghapusan           ChartOfAccount     @relation("CatAkunRugiPenghapusan", fields: [akunRugiPenghapusanId], references: [id])
  fixedAssets                   FixedAsset[]
  capitalizations               AssetCapitalization[]

  @@unique([tenantId, kode])
  @@index([tenantId])
}

// Kartu Induk Aset Tetap (Fixed Asset Register)
model FixedAsset {
  id                      String             @id @default(uuid())
  tenantId                String
  noAset                  String
  tagCode                 String
  categoryId              String
  nama                    String
  deskripsi               String?
  status                  FixedAssetStatus   @default(DRAFT)
  tanggalPerolehan        DateTime
  tanggalMulaiDigunakan   DateTime?
  mata_uang               String
  kurs                    Decimal            @default(1.0) @db.Decimal(19, 6)
  hargaPerolehanAsli      Decimal            @db.Decimal(19, 4)
  hargaPerolehan          Decimal            @db.Decimal(19, 4)
  nilaiResidu             Decimal            @default(0) @db.Decimal(19, 4)
  umurManfaatBulan        Int                @default(48)
  metodeKomersial         DepreciationMethod @default(GARIS_LURUS)
  faktorSaldoMenurun      Float              @default(2.0)
  fiscalGroupId           String?
  metodeFiskal            DepreciationMethod @default(GARIS_LURUS)
  fiskalMulaiTanggal      DateTime?
  fiskalUmurOverrideBulan Int?
  dimensions              Json?
  statusLabel             AssetLabelStatus   @default(BELUM_DILABEL)
  externalRef             String?
  sumberAplikasi          String             @default("MANUAL")
  sourceDocType           String?
  sourceDocId             String?
  createdBy               String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Kolom Denormalisasi Akuntansi (Diperbarui Atomik per Run Penyusutan & Penambahan Nilai)
  akumulasiKomersial      Decimal            @default(0) @db.Decimal(19, 4)
  akumulasiFiskal         Decimal            @default(0) @db.Decimal(19, 4)
  nilaiTercatat           Decimal            @default(0) @db.Decimal(19, 4)
  nilaiSisaBukuFiskal     Decimal            @default(0) @db.Decimal(19, 4)

  tenant                  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category                AssetCategory      @relation(fields: [categoryId], references: [id])
  fiscalGroup             FiscalDepreciationGroup? @relation(fields: [fiscalGroupId], references: [id], onDelete: SetNull)
  events                  AssetEvent[]
  attachments             AssetAttachment[]
  capitalizations         AssetCapitalization[]
  depreciationEntries     AssetDepreciationEntry[]
  estimateChanges         AssetEstimateChange[]
  costAdditions           AssetCostAddition[]
  dimensionHistories      AssetDimensionHistory[]
  transfers               AssetTransfer[]
  impairments             AssetImpairment[]
  disposals               AssetDisposal[]
  salesInvoiceLines       SalesInvoiceLine[]
  verificationScans       AssetVerificationScan[]

  @@unique([tenantId, noAset])
  @@unique([tenantId, tagCode])
  @@unique([tenantId, externalRef])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
}

// Catatan Linimasa & Riwayat Transaksi Aset (Audit Trail)
model AssetEvent {
  id         String         @id @default(uuid())
  assetId    String
  tipe       AssetEventType
  tanggal    DateTime
  data       Json
  journalId  String?
  createdBy  String?
  createdAt  DateTime       @default(now())

  asset      FixedAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([tipe])
}

// Lampiran File Bukti / Dokumen Aset
model AssetAttachment {
  id         String     @id @default(uuid())
  assetId    String
  namaFile   String
  tipe       String
  ukuran     Int
  storageKey String
  uploadedBy String?
  createdAt  DateTime   @default(now())

  asset      FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

// Dokumen Kapitalisasi Aset CIP ke Aset Tetap Aktif
model AssetCapitalization {
  id                    String                    @id @default(uuid())
  tenantId              String
  noDokumen             String
  tanggal               DateTime
  assetId               String
  categoryId            String
  tanggalMulaiDigunakan DateTime
  status                AssetCapitalizationStatus @default(DRAFT)
  journalId             String?
  createdBy             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset                 FixedAsset                @relation(fields: [assetId], references: [id])
  category              AssetCategory             @relation(fields: [categoryId], references: [id])

  @@unique([tenantId, noDokumen])
  @@index([tenantId])
  @@index([assetId])
}

// ==========================================
// MODUL 22: MESIN & PROSES PENYUSUTAN ASET
// ==========================================

enum AssetDepreciationRunStatus {
  POSTED
  REVERSED
}

enum DepreciationBook {
  KOMERSIAL
  FISKAL
  OPENING_KOMERSIAL
  OPENING_FISKAL
}

enum DepreciationEntryStatus {
  AKTIF
  REVERSED
}

// Dokumen Batch Proses Penyusutan Bulanan
model AssetDepreciationRun {
  id             String                     @id @default(uuid())
  tenantId       String
  noDokumen      String
  periodId       String
  status         AssetDepreciationRunStatus @default(POSTED)
  totalKomersial Decimal                    @db.Decimal(19, 4)
  totalFiskal    Decimal                    @default(0) @db.Decimal(19, 4)
  journalId      String?
  createdBy      String?
  postedAt       DateTime                   @default(now())
  reversedAt     DateTime?
  reversedBy     String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period         AccountingPeriod           @relation(fields: [periodId], references: [id])
  journal        Journal?                   @relation(fields: [journalId], references: [id], onDelete: SetNull)
  entries        AssetDepreciationEntry[]

  @@unique([tenantId, noDokumen])
  @@index([tenantId, periodId])
}

// Entri Penyusutan Buku Paralel (Komersial & Fiskal)
model AssetDepreciationEntry {
  id                   String                  @id @default(uuid())
  tenantId             String
  assetId              String
  runId                String?
  buku                 DepreciationBook        @default(KOMERSIAL)
  periodeBukuTahun     Int                     @default(2026)
  periodeBukuBulan     Int                     @default(1)
  periodeBebanId       String?
  jumlah               Decimal                 @default(0) @db.Decimal(19, 4)
  akumulasiSetelah     Decimal                 @default(0) @db.Decimal(19, 4)
  nilaiTercatatSetelah Decimal                 @default(0) @db.Decimal(19, 4)
  isCatchUp            Boolean                 @default(false)
  status               DepreciationEntryStatus @default(AKTIF)

  // Field pelengkap untuk histori & saldo awal
  periode              String?                 // YYYY-MM
  tanggal              DateTime?
  jumlahKomersial      Decimal?                @default(0) @db.Decimal(19, 4)
  jumlahFiskal         Decimal?                @default(0) @db.Decimal(19, 4)
  akumulasiKomersial   Decimal?                @default(0) @db.Decimal(19, 4)
  akumulasiFiskal      Decimal?                @default(0) @db.Decimal(19, 4)
  nilaiBukuKomersial   Decimal?                @default(0) @db.Decimal(19, 4)
  nilaiBukuFiskal      Decimal?                @default(0) @db.Decimal(19, 4)
  isOpening            Boolean                 @default(false)
  journalId            String?
  createdAt            DateTime                @default(now())

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset                FixedAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  run                  AssetDepreciationRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  periodeBeban         AccountingPeriod?       @relation(fields: [periodeBebanId], references: [id], onDelete: SetNull)

  @@unique([assetId, periodeBukuTahun, periodeBukuBulan, buku, status])
  @@index([tenantId, assetId])
  @@index([tenantId, runId])
  @@index([tenantId, periodeBukuTahun, periodeBukuBulan])
}

// Riwayat Perubahan Estimasi Akuntansi Aset (Masa Manfaat, Residu, Metode)
model AssetEstimateChange {
  id                  String              @id @default(uuid())
  tenantId            String
  assetId             String
  berlakuMulaiPeriode String              // YYYY-MM
  umurBaruBulan       Int?
  sisaUmurBulan       Int?
  residuBaru          Decimal?            @db.Decimal(19, 4)
  metodeBaru          DepreciationMethod?
  alasan              String
  createdBy           String?
  createdAt           DateTime            @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset               FixedAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId])
}

// Penambahan Nilai / Pengeluaran Lanjutan yang Dikapitalisasi (Subsequent Expenditure)
model AssetCostAddition {
  id                  String              @id @default(uuid())
  tenantId            String
  noDokumen           String
  assetId             String
  tanggal             DateTime
  jumlah              Decimal             @db.Decimal(19, 4)
  akunLawanId         String?
  sumber              String?             // KAS, HUTANG, MANUAL
  journalId           String?
  status              String              @default("POSTED") // POSTED, VOID
  deskripsi           String?
  createdBy           String?
  createdAt           DateTime            @default(now())

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset               FixedAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  akunLawan           ChartOfAccount?     @relation(fields: [akunLawanId], references: [id])
  journal             Journal?            @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, noDokumen])
  @@index([tenantId, assetId])
}

// =========================================================================
// MODUL 23: PERISTIWA SIKLUS HIDUP ASET LANJUTAN (MUTASI, IMPAIRMENT, PELEPASAN)
// =========================================================================

enum AssetTransferStatus {
  POSTED
  VOID
}

enum ImpairmentAccumulationMode {
  AKUMULASI_PENYUSUTAN
  AKUMULASI_PENURUNAN_NILAI
}

enum AssetImpairmentStatus {
  POSTED
  VOID
}

enum AssetDisposalType {
  JUAL_FAKTUR
  JUAL_TUNAI
  HAPUS
}

enum AssetDisposalStatus {
  POSTED
  VOID
}

// Riwayat Perubahan Dimensi Analitik Aset (Cost Center, Project, dsb)
model AssetDimensionHistory {
  id           String      @id @default(uuid())
  assetId      String
  berlakuMulai DateTime
  dimensions   Json
  alasan       String?
  createdBy    String?
  createdAt    DateTime    @default(now())

  asset        FixedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, berlakuMulai])
}

// Dokumen Mutasi / Transfer Lokasi & Dimensi Aset
model AssetTransfer {
  id          String              @id @default(uuid())
  tenantId    String
  noDokumen   String
  assetId     String
  tanggal     DateTime
  dari        Json                // Dimension lama
  ke          Json                // Dimension baru
  alasan      String
  status      AssetTransferStatus @default(POSTED)
  createdBy   String?
  createdAt   DateTime            @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       FixedAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([tenantId, noDokumen])
  @@index([tenantId, assetId])
}

// Dokumen Penurunan Nilai Aset (Impairment)
model AssetImpairment {
  id             String                     @id @default(uuid())
  tenantId       String
  noDokumen      String
  assetId        String
  tanggal        DateTime
  jumlah         Decimal                    @db.Decimal(19, 4)
  alasan         String
  modeAkumulasi  ImpairmentAccumulationMode @default(AKUMULASI_PENYUSUTAN)
  status         AssetImpairmentStatus      @default(POSTED)
  journalId      String?
  createdBy      String?
  createdAt      DateTime                   @default(now())

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset          FixedAsset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journal        Journal?                   @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, noDokumen])
  @@index([tenantId, assetId])
}

// Dokumen Pelepasan & Penghapusan Aset Tetap (Disposal / Write-off)
model AssetDisposal {
  id                         String              @id @default(uuid())
  tenantId                   String
  noDokumen                  String
  assetId                    String
  tanggal                    DateTime
  tipe                       AssetDisposalType
  alasan                     String
  hargaJual                  Decimal?            @db.Decimal(19, 4)
  salesInvoiceLineId         String?
  cashBankAccountId          String?
  nilaiTercatatSaatPelepasan Decimal             @db.Decimal(19, 4)
  labaRugi                   Decimal             @db.Decimal(19, 4)
  fiskalSisaBuku             Decimal             @db.Decimal(19, 4)
  fiskalLabaRugi             Decimal             @db.Decimal(19, 4)
  status                     AssetDisposalStatus @default(POSTED)
  journalId                  String?
  createdBy                  String?
  createdAt                  DateTime            @default(now())

  tenant                     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset                      FixedAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cashBankAccount            CashBankAccount?    @relation(fields: [cashBankAccountId], references: [id], onDelete: SetNull)
  salesInvoiceLine           SalesInvoiceLine?   @relation(fields: [salesInvoiceLineId], references: [id], onDelete: SetNull)
  journal                    Journal?            @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@unique([tenantId, noDokumen])
  @@index([tenantId, assetId])
}

// ==========================================
// MODUL 24: BARCODE LABELLING & READING ASET
// ==========================================

enum VerificationSessionStatus {
  BERLANGSUNG
  DITUTUP
}

enum VerificationScanResult {
  DITEMUKAN
  LOKASI_BERBEDA
  TIDAK_TERDAFTAR
}

// Template Desain Label Barcode/QR Aset Tetap
model AssetLabelTemplate {
  id        String             @id @default(uuid())
  tenantId  String
  nama      String
  lebarMm   Float
  tinggiMm  Float
  layout    Json               // Elemen dicetak: logo/nama perusahaan, nama aset, noAset, kategori, lokasi/Cost Center, tahun, QR/barcode & posisinya
  simbologi LabelSymbology     @default(QR)
  lembar    Json?              // Untuk lembar A4 multi-label: kolom, baris, margin, jarak
  isDefault Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printLogs AssetLabelPrintLog[]

  @@index([tenantId])
}

// Log / Riwayat Cetak Label Aset Tetap
model AssetLabelPrintLog {
  id         String              @id @default(uuid())
  tenantId   String
  templateId String?
  assetIds   Json                // Daftar assetId yang dicetak
  jumlah     Int
  alasan     String?             // Wajib jika cetak ulang
  printedBy  String
  printedAt  DateTime            @default(now())

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   AssetLabelTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}

// Sesi Verifikasi Fisik (Stock Opname Aset Ringkas)
model AssetVerificationSession {
  id            String                    @id @default(uuid())
  tenantId      String
  noDokumen     String
  nama          String
  tanggal       DateTime
  cakupan       Json                      // Filter cakupan: lokasi/Cost Center/kategori
  status        VerificationSessionStatus @default(BERLANGSUNG)
  snapshotHasil Json?                     // Snapshot hasil final saat sesi ditutup (termasuk BELUM_DITEMUKAN)
  createdBy     String
  closedBy      String?
  closedAt      DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scans         AssetVerificationScan[]

  @@unique([tenantId, noDokumen])
  @@index([tenantId, status])
}

// Hasil Pemindaian dalam Sesi Verifikasi
model AssetVerificationScan {
  id             String                   @id @default(uuid())
  sessionId      String
  assetId        String?
  tagCodeScanned String
  hasil          VerificationScanResult
  lokasiSesi     Json?                    // Lokasi saat scan berlangsung (mis. Dimension)
  device         String?
  scannedBy      String
  scannedAt      DateTime                 @default(now())

  session        AssetVerificationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  asset          FixedAsset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([sessionId, assetId])
  @@index([sessionId])
  @@index([assetId])
}










