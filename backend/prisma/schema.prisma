enum OrderStatus {
  DRAFT
  OPEN
  PARTIAL
  COMPLETED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  VOID
}

enum DeliveryOrderStatus {
  DRAFT
  POSTED
  VOID
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  tenantId          String
  noDokumen         String
  tanggal           DateTime
  tanggalDiharapkan DateTime?
  partnerId         String
  mata_uang         String
  kurs              Decimal             @default(1) @db.Decimal(19, 6)
  status            OrderStatus         @default(DRAFT)
  subtotal          Decimal             @default(0) @db.Decimal(19, 4)
  totalDiskon       Decimal             @default(0) @db.Decimal(19, 4)
  totalPpn          Decimal             @default(0) @db.Decimal(19, 4)
  total             Decimal             @default(0) @db.Decimal(19, 4)
  catatan           String?
  externalRef       String?
  idempotencyKey    String?
  createdBy         String?
  closedAt          DateTime?
  closedBy          String?
  cancelledAt       DateTime?
  cancelledBy       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner           BusinessPartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines             PurchaseOrderLine[]
  receipts          GoodsReceipt[]

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id           String             @id @default(uuid())
  poId         String
  itemId       String?
  deskripsi    String
  qty          Decimal            @db.Decimal(19, 4)
  harga        Decimal            @db.Decimal(19, 4)
  diskon       Decimal            @default(0) @db.Decimal(19, 4)
  ppnRate      Decimal            @default(0) @db.Decimal(19, 4)
  jumlah       Decimal            @default(0) @db.Decimal(19, 4)
  warehouseId  String?
  qtyDiterima  Decimal            @default(0) @db.Decimal(19, 4)
  qtyDitagih   Decimal            @default(0) @db.Decimal(19, 4)
  dimensions   Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  po           PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  item         Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  receiptLines GoodsReceiptLine[]

  @@index([poId])
}

model GoodsReceipt {
  id             String             @id @default(uuid())
  tenantId       String
  noDokumen      String
  tanggal        DateTime
  poId           String?
  partnerId      String
  warehouseId    String
  status         GoodsReceiptStatus @default(DRAFT)
  totalNilai     Decimal            @default(0) @db.Decimal(19, 4)
  journalId      String?
  voidJournalId  String?
  catatan        String?
  externalRef    String?
  idempotencyKey String?
  createdBy      String?
  postedAt       DateTime?
  postedBy       String?
  voidedAt       DateTime?
  voidedBy       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  po             PurchaseOrder?     @relation(fields: [poId], references: [id], onDelete: SetNull)
  partner        BusinessPartner    @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  journal        Journal?           @relation("GoodsReceiptJournal", fields: [journalId], references: [id], onDelete: SetNull)
  voidJournal    Journal?           @relation("GoodsReceiptVoidJournal", fields: [voidJournalId], references: [id], onDelete: SetNull)
  lines          GoodsReceiptLine[]

  @@unique([tenantId, noDokumen])
  @@unique([tenantId, idempotencyKey])
}

model GoodsReceiptLine {
  id          String             @id @default(uuid())
  receiptId   String
  poLineId    String?
  itemId      String
  deskripsi   String?
  qty         Decimal            @db.Decimal(19, 4)
  biayaSatuan Decimal            @db.Decimal(19, 4)
  totalNilai  Decimal            @db.Decimal(19, 4)
  qtyDitagih  Decimal            @default(0) @db.Decimal(19, 4)
  dimensions  Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  receipt     GoodsReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine      PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  item        Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([receiptId])
}

model SalesOrder {
  id                String            @id @default(uuid())
  tenantId          String
  noDokumen         String
  tanggal           DateTime
  tanggalDiharapkan DateTime?
  partnerId         String
  mata_uang         String
  kurs              Decimal           @default(1) @db.Decimal(19, 6)
  status            OrderStatus       @default(DRAFT)
  subtotal          Decimal           @default(0) @db.Decimal(19, 4)
  totalDiskon       Decimal           @default(0) @db.Decimal(19, 4)
  totalPpn          Decimal           @default(0) @db.Decimal(19, 4)
  total             Decimal           @default(0) @db.Decimal(19, 4)
  catatan           String?
  externalRef       String?
  idempotencyKey    String?
  createdBy         String?
  closedAt          DateTime?
  closedBy          String?
  cancelledAt       DateTime?
  cancelledBy       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner           BusinessPartner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
