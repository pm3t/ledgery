// ==========================================
// MODUL 15: SUB LEDGER INVENTORY (PERSEDIAAN)
// ==========================================

enum ItemType {
  STOK
  NON_STOK
  JASA
}

enum StockMovementType {
  RECEIPT_PURCHASE
  ISSUE_SALE
  RECEIPT_OTHER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_SALE
  RETURN_PURCHASE
  OPENING
  RECEIPT_GOODS_RECEIPT
  ISSUE_DELIVERY_ORDER
}

enum StockAdjustmentStatus {
  DRAFT
  POSTED
  VOID
}

enum StockTransferStatus {
  DRAFT
  POSTED
  VOID
}

enum StockReceiptOtherStatus {
  DRAFT
  POSTED
  VOID
}

model Item {
  id                String                   @id @default(uuid())
  tenantId          String
  kode              String
  nama              String
  groupCode         String?
  satuan            String                   @default("PCS")
  tipe              ItemType                 @default(STOK)
  akunPersediaanId  String?
  akunHppId         String?
  akunPendapatanId  String?
  valuationMethod   InventoryValuationMethod @default(MOVING_AVERAGE)
  externalRef       String?
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  akunPersediaan    ChartOfAccount?          @relation("ItemAkunPersediaan", fields: [akunPersediaanId], references: [id], onDelete: SetNull)
  akunHpp           ChartOfAccount?          @relation("ItemAkunHpp", fields: [akunHppId], references: [id], onDelete: SetNull)
  akunPendapatan    ChartOfAccount?          @relation("ItemAkunPendapatan", fields: [akunPendapatanId], references: [id], onDelete: SetNull)

  balances          StockBalance[]
  movements         StockMovement[]
  costLayers        StockCostLayer[]
  adjustmentLines   StockAdjustmentLine[]
  transferLines     StockTransferLine[]
  receiptOtherLines StockReceiptOtherLine[]
  poLines           PurchaseOrderLine[]
  grLines           GoodsReceiptLine[]
  soLines           SalesOrderLine[]
  doLines           DeliveryOrderLine[]

  @@unique([tenantId, kode])
  @@unique([tenantId, externalRef])
  @@index([tenantId, tipe, isActive])
}

model Warehouse {
  id                String             @id @default(uuid())
  tenantId          String
  kode              String
  nama              String
  alamat            String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances          StockBalance[]
  movements         StockMovement[]
  costLayers        StockCostLayer[]
  adjustments       StockAdjustment[]
  fromTransfers     StockTransfer[]    @relation("FromWarehouse")
  toTransfers       StockTransfer[]    @relation("ToWarehouse")
  receiptOthers     StockReceiptOther[]
  goodsReceipts     GoodsReceipt[]
  deliveryOrders    DeliveryOrder[]
  poLines           PurchaseOrderLine[]
  soLines           SalesOrderLine[]

  @@unique([tenantId, kode])
  @@index([tenantId, isActive])
}

model StockBalance {
  id            String    @id @default(uuid())
  tenantId      String
  itemId        String
  warehouseId   String
  qty           Decimal   @default(0) @db.Decimal(19, 4)
  nilai         Decimal   @default(0) @db.Decimal(19, 4)
  biayaRataRata Decimal   @default(0) @db.Decimal(19, 4)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, warehouseId])
  @@index([tenantId, warehouseId])
}

model StockCostLayer {
  id              String                  @id @default(uuid())
  tenantId        String
  itemId          String
  warehouseId     String
  movementMasukId String?
  tanggalMasuk    DateTime
  qtyAwal         Decimal                 @db.Decimal(19, 4)
  qtySisa         Decimal                 @db.Decimal(19, 4)
  biayaSatuan     Decimal                 @db.Decimal(19, 4)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item            Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse       Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movementMasuk   StockMovement?          @relation("MovementCostLayers", fields: [movementMasukId], references: [id], onDelete: SetNull)
  consumptions    StockLayerConsumption[]

  @@index([tenantId, itemId, warehouseId, qtySisa])
  @@index([tenantId, tanggalMasuk])
}

model StockLayerConsumption {
  id               String         @id @default(uuid())
  movementKeluarId String
  layerId          String
  qty              Decimal        @db.Decimal(19, 4)
  biayaSatuan      Decimal        @db.Decimal(19, 4)
  createdAt        DateTime       @default(now())

  movementKeluar   StockMovement  @relation("MovementConsumptions", fields: [movementKeluarId], references: [id], onDelete: Cascade)
  layer            StockCostLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  @@index([movementKeluarId])
  @@index([layerId])
}

model StockMovement {
  id             String                  @id @default(uuid())
  tenantId       String
  tanggal        DateTime
  itemId         String
  warehouseId    String
  tipe           StockMovementType
  qty            Decimal                 @db.Decimal(19, 4)
  biayaSatuan    Decimal                 @db.Decimal(19, 4)
  nilai          Decimal                 @db.Decimal(19, 4)
  sourceDocType  String?
  sourceDocId    String?
  journalId      String?
  createdBy      String?
  createdAt      DateTime                @default(now())

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item           Item                    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse      Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  journal        Journal?                @relation(fields: [journalId], references: [id], onDelete: SetNull)

  inLayers       StockCostLayer[]        @relation("MovementCostLayers")
  consumptions   StockLayerConsumption[] @relation("MovementConsumptions")

  @@index([tenantId, itemId, warehouseId, tanggal])
  @@index([tenantId, sourceDocType, sourceDocId])
}

model StockAdjustment {
  id                 String                @id @default(uuid())
  tenantId           String
  noDokumen          String
  tanggal            DateTime
  warehouseId        String
  status             StockAdjustmentStatus @default(DRAFT)
  totalSelisihNilai  Decimal               @default(0) @db.Decimal(19, 4)
  catatan            String?
  journalId          String?
  voidJournalId      String?
  createdBy          String?
  postedAt           DateTime?
  postedBy           String?
  voidedAt           DateTime?
  voidedBy           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  journal            Journal?              @relation("StockAdjustmentJournal", fields: [journalId], references: [id], onDelete: SetNull)
  voidJournal        Journal?              @relation("StockAdjustmentVoidJournal", fields: [voidJournalId], references: [id], onDelete: SetNull)
  lines              StockAdjustmentLine[]

  @@unique([tenantId, noDokumen])
  @@index([tenantId, warehouseId, status])
}

model StockAdjustmentLine {
  id           String          @id @default(uuid())
  adjustmentId String
  itemId       String
  qtySistem    Decimal         @db.Decimal(19, 4)
  qtyFisik     Decimal         @db.Decimal(19, 4)
  selisihQty   Decimal         @db.Decimal(19, 4)
  biayaSatuan  Decimal         @db.Decimal(19, 4)
  selisihNilai Decimal         @db.Decimal(19, 4)
  catatan      String?

  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item         Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
}

model StockTransfer {
  id              String              @id @default(uuid())
  tenantId        String
  noDokumen       String
  tanggal         DateTime
  fromWarehouseId String
  toWarehouseId   String
  status          StockTransferStatus @default(DRAFT)
  totalNilai      Decimal             @default(0) @db.Decimal(19, 4)
  catatan         String?
  journalId       String?
  voidJournalId   String?
  createdBy       String?
  postedAt        DateTime?
  postedBy        String?
  voidedAt        DateTime?
  voidedBy        String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  journal         Journal?            @relation("StockTransferJournal", fields: [journalId], references: [id], onDelete: SetNull)
  voidJournal     Journal?            @relation("StockTransferVoidJournal", fields: [voidJournalId], references: [id], onDelete: SetNull)
  lines           StockTransferLine[]

  @@unique([tenantId, noDokumen])
}

model StockTransferLine {
  id          String        @id @default(uuid())
  transferId  String
  itemId      String
  qty         Decimal       @db.Decimal(19, 4)
  biayaSatuan Decimal       @db.Decimal(19, 4)
  totalNilai  Decimal       @db.Decimal(19, 4)

  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item        Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([transferId])
}

model StockReceiptOther {
  id             String                  @id @default(uuid())
  tenantId       String
  noDokumen      String
  tanggal        DateTime
  warehouseId    String
